# pg-dev-init 建库参数 —— 在一台已由 pg-dev-server 装好的开发服务器上，为一个项目建库 + 角色。
# 只有 DB_NAME 必填。用法：复制为 pg-dev-init.env 填好，再 scripts/render.sh 渲染成自包含脚本。此文件 gitignored。

PG_OPS_ROLE=dev             # 生产守卫：脚本只在值为 dev 时执行
DB_NAME=myproj              # 必填。开发库名，通常 = 项目名。[a-z_][a-z0-9_]*，且不能以 pg_ 开头（PG 保留前缀给系统角色，owner 默认与库同名会被拒；写 pgskills 而非 pg_skills）
DB_USER=                    # 留空 = 同 DB_NAME。库 owner，单账号；同样不能以 pg_ 开头。最小权限拆分见 pg-roles
DB_PASS=                    # 留空 = 新建角色时自动生成并记入交接文档（不打印到 stdout）；角色已存在则保持原口令不变。填了 = 设为该值（用于换密）
SCRATCH_DB=                 # 留空 = ${DB_NAME}_scratch（可炸的空库，排练迁移用）；写 none 不建
CREATEDB=                   # 留空或 0 = 不动角色（不收回已有的 CREATEDB）；1 = 授予 CREATEDB（可自建/删测试克隆库），幂等
REDIS_DB=                   # 留空 = 自动分配（从 1 起，跳过其它项目已用号，换密重跑沿用文档已分配的号）；填数字钉死；0 保留不可用
