# pg-dev-server 装机参数 —— 只有服务器级参数，不含任何项目的库 / 角色（那些归 pg-dev-init）。
# 用法：复制为 pg-dev-server.env 填好，再 scripts/render.sh 渲染成自包含安装脚本。此文件 gitignored。
# 所有服务只监听 127.0.0.1；开发机经 SSH 隧道进来。

PG_OPS_ROLE=dev             # 生产守卫：脚本只在值为 dev 时执行；生产机上永远不要写 dev
SSH_TARGET=devdb            # ssh 别名或 user@host，只用于生成命令与交接文档
PUBLIC_IP=                  # 公网 IP，只用于交接文档里的安全组说明；内网机留空
PG_MAJOR=18                 # PostgreSQL 大版本，MUST 与生产一致
DATA_ROOT=/data             # 数据盘根：PG 集群放 ${DATA_ROOT}/postgresql/<ver>/main，Redis 放 ${DATA_ROOT}/redis；留空 = 发行版默认（/var/lib）
PGDG_MIRROR=                # PGDG apt 镜像；留空 = 官方 apt.postgresql.org（国内很慢）。国内机器填 https://mirrors.aliyun.com/postgresql/repos/apt

PGB_PORT=6432               # PgBouncer transaction 池监听口：仅为兼容既有代码保留，不是缺省
PGB_SESSION_PORT=7432       # PgBouncer session 池监听口（第二实例）：**缺省经池子就用它**——会话级特性全可用；两种模式的区别、选法与容量代价见交接文档第 3 节
PGB_MAX_CLIENT_CONN=200
PGB_DEFAULT_POOL_SIZE=20
PGB_AUTH_PASS=              # PgBouncer 认证角色（auth_query 用）的口令；留空 = 首次自动生成并复用，只落在服务器

REDIS_PORT=6379
REDIS_PASS=                 # 留空（推荐）= 服务器首次生成、之后沿用 redis.conf 里的；真相在服务器 /opt/pg-ops/handover.md
PG_SUPER_PASS=              # 超级用户 postgres 的网络口令（DB 工具经隧道连 5432 看 / 管全部库用）；留空（推荐）= 首次生成、之后沿用服务器 /opt/pg-ops/postgres.pass。填了就是换密
PG_STAT_STATEMENTS_MAX=50000 # pg_stat_statements.max；PG 默认 5000，表名带变量的库（t_<id>、按月分表）query text 会爆炸，
                             # 5000 装不下就每几秒淘汰一次，top 榜退化成"最高频"而非"最耗时"，归因全错；按表数上调（生产 8000+ 张表取到 100000）

# ---- 安全加固（harden 脚本用；云安全组在控制台配，见交接文档）----
SSH_ALLOW_FROM=             # 允许 SSH 的来源 CIDR，空格分隔（如 "1.2.3.4/32 10.0.0.0/8"）；留空 = 任意来源，靠密钥 + fail2ban

# ---- 小内存机（2 核 2G 起步）资源上限；三项都可按机器规格改 ----
SWAP_GB=2                   # /swapfile 大小（G）；0 = 不建。已有 swap 时脚本自动跳过
PG_SHARED_BUFFERS=256MB     # 2G 机取 256MB；4G 取 512MB～1GB（约总内存 1/4，再大挤页缓存）
REDIS_MAXMEMORY=256mb       # 超过按 REDIS_MAXMEMORY_POLICY 淘汰；留空 = 不限（不建议与 PG 同机时留空）
REDIS_MAXMEMORY_POLICY=volatile-lru  # 打满时淘汰谁。volatile-* 只淘汰带 TTL 的键：项目在 Redis 存无 TTL 的持久键（吊销 / 锁 / 计数）时 MUST 用 volatile-* 或 noeviction；纯缓存项目可改 allkeys-lru
