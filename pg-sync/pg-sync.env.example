# pg-sync 开发机 env —— 从生产拉快照到开发库的参数：dev 侧脚本直接用；生产侧 env 模板（templates/prod-env.example）
# 的非敏感项由 render.sh bundle 从本文件预填。模型可写可读，不含任何敏感值——生产侧敏感项（EXPECT_SYSID /
# EXPECT_HOSTNAME / DUMP_DIR）在生产机上人填，模型不读不接触（ADR-0001）。
# 用法：复制为 .pg-ops/pg-sync.env 填好，再用 scripts/render.sh 渲染 bundle（生产）或 dev 脚本（本机）。此文件 gitignored。

PG_OPS_ROLE=dev              # 生产守卫：dev 侧脚本只在值为 dev 时执行
SSH_TARGET=                  # dev 主机别名；留空 = 从 .pg-ops/pg-dev-server.env 抄
DB_NAME=                     # dev 目标库；留空 = 从 .pg-ops/pg-dev-init.env 抄
DB_OWNER=                    # 库 owner 角色；留空 = 从 .pg-ops/pg-dev-init.env 的 DB_USER 抄，再空则 = DB_NAME

# 数据裁剪规则（本质多行，但本文件里必须写成单个带引号的值，多条规则用字面 \n 分隔——保持单物理行，
# render.sh 才能用逐行 grep 把整份 env 内联进 dev 自包含脚本）：每条规则 `<表模式> <策略> [参数…]`，`#` 注释，
# 先匹配先赢，模式用 pg_dump -t 通配（schema.table，* ?，无 schema 视为 public）。
# 策略：full | none | sample K | window <列> <N>(d|h)。示例（多条规则）：
#   DATA_RULES="logs.*  window created_at 90d\ndata.n_*_2026  window created_time 30d\n*  full"
# 示例见 SKILL.md「data 阶段」。缺省整库 full（必须加引号，`*` 不加引号会被 shell 当文件名通配展开）：
DATA_RULES="* full"

# ---- 传输路线 A：rsync（生产 → dev，内网/隧道可达时用）----
RSYNC_DEST_HOST=              # dev 主机内网地址；留空 = 从 .pg-ops/pg-dev-server.env 推
RSYNC_DEST_USER=pgsync        # dev 上受限收件用户（receive-setup 建，无 shell 权限以外能力）
RSYNC_DEST_DIR=                # dev 上收件目录；留空 = <DATA_ROOT>/pg-ops/sync/incoming
RSYNC_SRC_PUBKEY=              # 生产首跑 30-transport-rsync.sh 打印的公钥，人贴进来（含空格，须加引号），receive-setup 用
RSYNC_SRC_IP=                  # 生产出口 IP，receive-setup 放行 22 用；空则不动 ufw
RSYNC_DEST_HOSTKEY=            # dev 主机公钥（receive-setup 结尾打印的 ssh-keyscan -t ed25519 一行，含空格，须加引号），
                               # 人贴进来；渲染进生产 env，传输脚本写 known_hosts 用（StrictHostKeyChecking=yes）

# ---- 传输路线 B：OSS（生产 → dev 网络不可达时用，两侧各自 endpoint；AccessKey 各机 ossutil config 单独配，不在此）----
OSS_BUCKET=
OSS_PREFIX=
OSS_ENDPOINT_UPLOAD=           # 生产侧用，外网 endpoint
OSS_ENDPOINT_DOWNLOAD=         # dev 侧用，内网 endpoint

RESTORE_JOBS=                  # pg_restore -j；留空 = nproc
POST_RESTORE_SQL=               # 装载后在 <库>_sync 执行的 SQL 文件路径（相对消费仓根），留空不跑
POST_RESTORE_HOOK=              # 装载后执行的脚本路径（相对消费仓根，收到 PG_SYNC_DB 环境变量），留空不跑

SYNC_SAME_CLUSTER_OK=           # 仅自测用：=1 时允许源目标同一集群（仍须同时满足 dev 标记 + 目标库名 ≠ 源库名）；
                                # 对接真生产时永远留空——留空 = 默认拒绝同集群同步
