# pg-sync 生产机 env —— 随 bundle 一起复制到生产机（/tmp/pg-sync/ 或人指定目录），脚本 source 同目录本文件，
# 不读任何其它地方的 env。模型只预填非敏感项（下面双花括号占位由 render.sh bundle 从开发机 pg-sync.env 替换）；
# 敏感三项（EXPECT_SYSID / EXPECT_HOSTNAME / DUMP_DIR）留空，注释里给取值命令，人在生产机上跑完填入。
# 本文件含身份核对与落盘路径，不进仓、不回传开发机（ADR-0001）。

SRC_DB={{SRC_DB}}                          # 生产库名（= 项目 dev 库对应的生产库；人可改）

# ---- 身份核对：EXPECT_SYSID 为空时 10-dump-schema / 20-dump-data 拒跑，只有 00-inventory 豁免 ----
EXPECT_SYSID=                              # 首跑 00-inventory.sh 会打印这台机的 system_identifier 并提示填入；
                                            # 也可直接跑：sudo -u postgres psql -Atc "select system_identifier from pg_control_system()"
EXPECT_HOSTNAME=                           # 可选，比对 hostname；取值：hostname
DUMP_DIR=                                  # 落盘目录（须有足够空间；大库应指到独立数据盘，如 /data2）；先 df -h 看剩余空间再定

PG_BIN=                                    # pg_dump / pg_restore 所在目录；留空 = PATH 里的默认版本

# ---- 数据裁剪规则：与开发机 pg-sync.env 的 DATA_RULES 同一段文本（多条规则用字面 \n 分隔，保持单物理行）----
DATA_RULES="{{DATA_RULES}}"

# ---- 资源限速 / 超时 ----
NICE={{NICE}}                              # nice 优先级（越大越让路）
IONICE={{IONICE}}                          # ionice 参数（如 -c3 = idle 优先级）
LOCK_WAIT_TIMEOUT={{LOCK_WAIT_TIMEOUT}}    # pg_dump --lock-wait-timeout，同时用作 COPY 会话的 lock_timeout
WINDOW_SEQSCAN_RED=                        # window 普通表无索引时的标红阈值（字节）；留空 = 缺省 1073741824（1 GiB）

# ---- 传输路线 A：rsync ----
RSYNC_DEST_HOST={{RSYNC_DEST_HOST}}
RSYNC_DEST_USER={{RSYNC_DEST_USER}}
RSYNC_DEST_DIR={{RSYNC_DEST_DIR}}
RSYNC_DEST_HOSTKEY="{{RSYNC_DEST_HOSTKEY}}"  # dev 主机公钥（含空格），写 $DUMP_DIR/keys/known_hosts 用（StrictHostKeyChecking=yes）

# ---- 传输路线 B：OSS（AccessKey 不在这里，人在生产机上单独 ossutil config）----
OSS_BUCKET={{OSS_BUCKET}}
OSS_PREFIX={{OSS_PREFIX}}
OSS_ENDPOINT_UPLOAD={{OSS_ENDPOINT_UPLOAD}}
